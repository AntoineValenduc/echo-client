# Copie ce fichier en .env et adapte les valeurs.
# Expo n'expose au bundle client que les variables prefixees EXPO_PUBLIC_
# (voir https://docs.expo.dev/guides/environment-variables/) - ne jamais
# y mettre de secret qui ne doit pas finir dans le bundle de l'app.

# URL de base de l'API backend Symfony.
EXPO_PUBLIC_API_URL=http://localhost:8000